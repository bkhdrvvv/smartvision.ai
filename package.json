    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@react-three/postprocessing": "^3.0.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "embedded-postgres": "^17.2.0-beta.15",
    "framer-motion": "^11.15.0",
    "gsap": "^3.12.5",
    "hls.js": "^1.5.17",
    "jose": "^5.9.6",
    "lucide-react": "^0.468.0",
    "next": "15.5.4",
    "nodemailer": "^6.9.16",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.54.0",
    "three": "^0.172.0",
