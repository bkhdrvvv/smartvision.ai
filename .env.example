# PostgreSQL. Local: `npm run db` starts a real PostgreSQL 17 (data in ./.pgdata) with this password.
PG_PASSWORD="change-me-long-random"
PG_PORT="54329"
DATABASE_URL="postgres://smartvision:change-me-long-random@127.0.0.1:54329/smartvision_utf8?connect_timeout=30&pool_timeout=30"

# Long random string (min 32 chars) used to sign session cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public site URL (used in email links and the Google redirect URI)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seed credentials (only used by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@smartvision.ai"
SEED_ADMIN_PASSWORD="change-me-admin"
SEED_DEMO_PASSWORD="demo12345"

# Face / head snapshots from the Edge AI agent are deleted after this many days (personal data)
SNAPSHOT_RETENTION_DAYS="30"

# Receipt storage: "local" (./uploads, private) or "cloudinary"
STORAGE_DRIVER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email (sign-up / sign-in codes, password reset, alerts). Without SMTP every email only lands in Admin → Outbox.
# Gmail: turn on 2-Step Verification, then https://myaccount.google.com/apppasswords → create an app password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="SMARTVISION AI <you@gmail.com>"

# Google sign-in (the button is hidden while these are empty).
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID (Web application).
# Authorized redirect URI: <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMS via Eskiz.uz (optional)
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
