[Unit]
Description=SMARTVISION AI website
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
User=smartvision
WorkingDirectory=/opt/smartvision
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 3000 -H 127.0.0.1
Restart=always
RestartSec=5
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/smartvision/uploads /opt/smartvision/backups /opt/smartvision/.next

[Install]
WantedBy=multi-user.target
