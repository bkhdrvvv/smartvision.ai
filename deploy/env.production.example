# SMARTVISION AI — production settings (setup.sh fills the __placeholders__).
DATABASE_URL="postgres://smartvision:__DB_PASSWORD__@127.0.0.1:5432/smartvision?connect_timeout=30&pool_timeout=30"
AUTH_SECRET="__AUTH_SECRET__"
NEXT_PUBLIC_SITE_URL="https://__DOMAIN__"
STORAGE_DRIVER="local"
SNAPSHOT_RETENTION_DAYS="30"

# copy these from the old .env on the office PC:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="SmartVision Ai <you@gmail.com>"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GEMINI_API_KEY=""
